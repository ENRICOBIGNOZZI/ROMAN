# Reselling BOT risk / paper settings
ROMAN_PAPER_CAPITAL=10000
# Provisional shadow-mode posterior error budget. This is tightened after 24/48h calibration.
ROMAN_FDR_ALPHA=0.25
ROMAN_FX_FRICTION=0.004

# Official / approved API credentials only. Never commit real secrets.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# eBay Browse marketplace context, e.g. EBAY_CH, EBAY_DE, EBAY_IT.
EBAY_MARKETPLACE_ID=EBAY_CH
STOCKX_API_KEY=
STOCKX_ACCESS_TOKEN=
REVERB_TOKEN=
ETSY_API_KEY=
ETSY_OAUTH_TOKEN=
MELI_ACCESS_TOKEN=
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=

# Additional authorized/partner/licensed market data.
# Ricardo: token credential obtained through Ricardo's partnership/authentication flow.
RICARDO_TOKEN=
# PriceCharting: paid API token (videogames / marketplace / guide data).
PRICECHARTING_TOKEN=
# TCG API: pricing reference key. Commercial deployments require an appropriate commercial-use tier.
TCGAPI_KEY=

# Vertical official APIs / partner access.
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN=
BRICKLINK_TOKEN_SECRET=
DISCOGS_TOKEN=
# TCGplayer currently documents that new API access is not being granted; retained for existing keys.
TCGPLAYER_PUBLIC_KEY=
TCGPLAYER_PRIVATE_KEY=

# Vinted, Tutti, Subito, Wallapop, Kleinanzeigen and Leboncoin are intentionally
# not configured with scraper credentials: current terms prohibit automated
# extraction without authorization. Add them only through an approved partner or
# licensed data feed.
